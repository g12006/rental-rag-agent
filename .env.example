# DeepSeek（OpenAI 兼容协议）—— 必填，否则无法启动
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# 本地 BGE-M3 嵌入模型路径
EMBED_MODEL_PATH=D:\models\BAAI\bge-m3
EMBED_DIM=1024

# 知识库目录与过滤（只保留路径含该关键词的文档）
DOCUMENT_PATH=C:\Users\龚祎\Desktop\学习资料\LangChain学习资料\课堂代码\PythonProject\Docs\markdown
DOC_SOURCE_FILTER=租房

# 向量后端：milvus（BGE-M3 + Milvus Lite） / memory（OpenAIEmbeddings + InMemoryVectorStore）
VECTOR_BACKEND=milvus
# Milvus 库目录，必须是纯 ASCII 路径（faiss 在 Windows 写不了中文路径的索引文件）
MILVUS_DB_DIR=C:\ragdata

# 检索参数
TOP_K=5
MIN_SCORE=0.50
MAX_CHARS=1500

# 分块策略：fixed / sentence / recursive / semantic / structure / llm / langchain
CHUNK_STRATEGY=sentence

# 编排
MAX_REWRITE=2
MAX_MESSAGES=10
HUMAN_REVIEW=false

# 服务
API_HOST=127.0.0.1
API_PORT=8080
